diff --git a/subprojects/slirp/test/arx-egress-test.c b/subprojects/slirp/test/arx-egress-test.c
new file mode 100644
index 0000000..d5cf2d7
--- /dev/null
+++ b/subprojects/slirp/test/arx-egress-test.c
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Exercise the production matcher and parser without opening any sockets. */
+#include "../src/arx-egress.c"
+
+static void deny_both(Slirp *slirp, uint32_t host)
+{
+    struct socket so = { .slirp = slirp };
+    struct sockaddr_storage peer = { 0 };
+    struct sockaddr_in *ipv4 = (struct sockaddr_in *)&peer;
+
+    ipv4->sin_family = AF_INET;
+    ipv4->sin_port = htons(443);
+    ipv4->sin_addr.s_addr = htonl(host);
+    g_assert_false(arx_allows(slirp, ipv4->sin_addr));
+    g_assert_false(arx_check_peer(&so, &peer));
+    g_assert_false(g_atomic_int_get(&slirp->arx->faulted));
+}
+
+static void test_matcher(void)
+{
+    static const uint32_t boundaries[][2] = {
+        { 0x00000000, 0x00ffffff }, { 0x0a000000, 0x0affffff },
+        { 0x64400000, 0x647fffff }, { 0x7f000000, 0x7fffffff },
+        { 0xa9fe0000, 0xa9feffff }, { 0xac100000, 0xac1fffff },
+        { 0xc0000000, 0xc00000ff }, { 0xc0000200, 0xc00002ff },
+        { 0xc0586300, 0xc05863ff }, { 0xc0a80000, 0xc0a8ffff },
+        { 0xc6120000, 0xc613ffff }, { 0xc6336400, 0xc63364ff },
+        { 0xcb007100, 0xcb0071ff }, { 0xe0000000, 0xefffffff },
+        { 0xf0000000, 0xffffffff },
+    };
+    struct ArxEgress policy = {
+        .deny = g_array_new(FALSE, FALSE, sizeof(struct ArxPrefix)),
+    };
+    Slirp slirp = {
+        .arx = &policy,
+        .vnetwork_addr = { .s_addr = htonl(0x0a000200) },
+        .vnetwork_mask = { .s_addr = htonl(0xffffff00) },
+    };
+
+    g_assert_cmpuint(G_N_ELEMENTS(boundaries), ==, G_N_ELEMENTS(arx_special));
+    for (size_t i = 0; i < G_N_ELEMENTS(boundaries); i++) {
+        for (size_t j = 0; j < G_N_ELEMENTS(boundaries[i]); j++) {
+            deny_both(&slirp, boundaries[i][j]);
+        }
+    }
+    for (uint32_t addr = 0x0a000200; addr <= 0x0a0002ff; addr++) {
+        deny_both(&slirp, addr);
+    }
+    add_prefix(&policy, 0x08080400, 24);
+    deny_both(&slirp, 0x08080404);
+    g_assert_true(arx_allows(&slirp, (struct in_addr){ .s_addr = htonl(0x08080808) }));
+    g_assert_true(arx_allows(&slirp, (struct in_addr){ .s_addr = htonl(0x64800000) }));
+
+    struct socket so = { .slirp = &slirp };
+    struct sockaddr_storage peer = { .ss_family = AF_INET6 };
+    g_assert_false(arx_check_peer(&so, &peer));
+
+    /* Isolate the synthetic subnet rule from the compiled private ranges. */
+    slirp.vnetwork_addr.s_addr = htonl(0x08080800);
+    deny_both(&slirp, 0x08080808);
+    slirp.vnetwork_addr.s_addr = htonl(0x0a000200);
+
+    g_atomic_int_set(&policy.faulted, true);
+    g_assert_false(arx_allows(&slirp, (struct in_addr){ .s_addr = htonl(0x08080808) }));
+    g_array_free(policy.deny, TRUE);
+}
+
+static bool parse_fixture(const char *body, bool fingerprint_ok)
+{
+    struct ArxEgress policy = {
+        .deny = g_array_new(FALSE, FALSE, sizeof(struct ArxPrefix)),
+    };
+    g_autofree char *digest = g_compute_checksum_for_string(G_CHECKSUM_SHA256, body, -1);
+    if (!fingerprint_ok) {
+        digest[0] = digest[0] == '1' ? '0' : '1';
+    }
+    g_autofree char *policy_bytes = g_strdup_printf("%sfingerprint=%s\n", body, digest);
+    bool ok = parse_policy(&policy, policy_bytes, strlen(policy_bytes));
+
+    g_array_free(policy.deny, TRUE);
+    return ok;
+}
+
+static void test_parser(void)
+{
+#define HEADER "version=1\ninterface_index=7\ninterface_luid=1234\nsource=192.0.2.2\ngateway=192.0.2.1\n"
+    g_assert_true(parse_fixture(HEADER, true));
+    g_assert_true(parse_fixture(HEADER "deny=192.0.2.0/24\ndeny=8.8.4.4/32\n", true));
+    g_assert_false(parse_fixture(HEADER, false));
+    g_assert_false(parse_fixture("version=1\ninterface_index=7\ninterface_luid=18446744073709551616\nsource=192.0.2.2\ngateway=192.0.2.1\n", true));
+    g_assert_false(parse_fixture(HEADER "deny=192.0.2.1/24\n", true));
+    g_assert_false(parse_fixture(HEADER "deny=192.0.2.0/24\ndeny=192.0.2.0/24\n", true));
+    g_assert_false(parse_fixture(HEADER "deny=0.0.0.0/0\n", true));
+    g_assert_false(parse_fixture(HEADER "deny=8.8.4.4/33\n", true));
+    g_assert_false(parse_fixture(HEADER "unexpected=1\n", true));
+    g_assert_false(parse_fixture(HEADER "\n", true));
+    g_assert_false(parse_fixture("version=2\ninterface_index=7\ninterface_luid=1234\nsource=192.0.2.2\ngateway=192.0.2.1\n", true));
+    g_assert_false(parse_fixture("version=1\ninterface_index=4294967296\ninterface_luid=1234\nsource=192.0.2.2\ngateway=192.0.2.1\n", true));
+#undef HEADER
+}
+
+int main(int argc, char **argv)
+{
+    WSADATA wsa;
+
+    g_test_init(&argc, &argv, NULL);
+    g_assert_cmpint(WSAStartup(MAKEWORD(2, 2), &wsa), ==, 0);
+    g_test_add_func("/arx-egress/matcher", test_matcher);
+    g_test_add_func("/arx-egress/policy-parser", test_parser);
+    int result = g_test_run();
+    WSACleanup();
+    return result;
+}
