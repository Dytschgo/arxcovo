diff --git a/subprojects/slirp/src/arx-egress.c b/subprojects/slirp/src/arx-egress.c
new file mode 100644
index 0000000..293b39f
--- /dev/null
+++ b/subprojects/slirp/src/arx-egress.c
@@ -0,0 +1,515 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#include "slirp.h"
+
+#ifdef _WIN32
+#include <iphlpapi.h>
+
+#define ARX_MAX_POLICY (32 * 1024)
+#define ARX_MAX_DENY 512
+#define ARX_MAX_ADDRESSES 4096
+
+struct ArxPrefix {
+    uint32_t network;
+    uint32_t mask;
+};
+
+#define ARX_PREFIX(net, bits) { (net), UINT32_MAX << (32 - (bits)) }
+
+/* Frozen IPv4 special-purpose policy. Keep the entire IETF assignments
+ * block and the deprecated 6to4 relay block closed, including exceptions. */
+static const struct ArxPrefix arx_special[] = {
+    ARX_PREFIX(0x00000000u, 8),  /* 0.0.0.0/8               This network */
+    ARX_PREFIX(0x0a000000u, 8),  /* 10.0.0.0/8              Private */
+    ARX_PREFIX(0x64400000u, 10), /* 100.64.0.0/10           Shared */
+    ARX_PREFIX(0x7f000000u, 8),  /* 127.0.0.0/8             Loopback */
+    ARX_PREFIX(0xa9fe0000u, 16), /* 169.254.0.0/16          Link-local */
+    ARX_PREFIX(0xac100000u, 12), /* 172.16.0.0/12           Private */
+    ARX_PREFIX(0xc0000000u, 24), /* 192.0.0.0/24            IETF assignments */
+    ARX_PREFIX(0xc0000200u, 24), /* 192.0.2.0/24            TEST-NET-1 */
+    ARX_PREFIX(0xc0586300u, 24), /* 192.88.99.0/24          Deprecated 6to4 */
+    ARX_PREFIX(0xc0a80000u, 16), /* 192.168.0.0/16          Private */
+    ARX_PREFIX(0xc6120000u, 15), /* 198.18.0.0/15           Benchmarking */
+    ARX_PREFIX(0xc6336400u, 24), /* 198.51.100.0/24         TEST-NET-2 */
+    ARX_PREFIX(0xcb007100u, 24), /* 203.0.113.0/24          TEST-NET-3 */
+    ARX_PREFIX(0xe0000000u, 4),  /* 224.0.0.0/4             Multicast */
+    ARX_PREFIX(0xf0000000u, 4),  /* 240.0.0.0/4             Reserved/broadcast */
+};
+
+struct ArxEgress {
+    HANDLE file;
+    HANDLE route_notify;
+    HANDLE address_notify;
+    HANDLE interface_notify;
+    uint32_t index;
+    NET_LUID luid;
+    struct in_addr source;
+    struct in_addr gateway;
+    GArray *deny;
+    gint faulted; /* Windows notifications run on another thread. */
+    bool quiesced;
+    void (*fault)(void);
+    gint64 next_health_check;
+};
+
+static bool prefix_matches(const struct ArxPrefix *table, size_t count,
+                           uint32_t address)
+{
+    for (size_t i = 0; i < count; i++) {
+        if ((address & table[i].mask) == table[i].network) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void add_prefix(struct ArxEgress *policy, uint32_t address, unsigned bits)
+{
+    uint32_t mask = UINT32_MAX << (32 - bits);
+    struct ArxPrefix prefix = { address & mask, mask };
+    g_array_append_val(policy->deny, prefix);
+}
+
+static bool parse_decimal(const char *text, uint64_t max, uint64_t *value)
+{
+    uint64_t result = 0;
+
+    if (text[0] < '1' || text[0] > '9') {
+        return false;
+    }
+    for (; *text; text++) {
+        if (!g_ascii_isdigit(*text)) {
+            return false;
+        }
+        unsigned digit = *text - '0';
+        if (result > (max - digit) / 10) {
+            return false;
+        }
+        result = result * 10 + digit;
+    }
+    *value = result;
+    return true;
+}
+
+static bool parse_ipv4(const char *text, struct in_addr *address)
+{
+    char canonical[INET_ADDRSTRLEN];
+
+    return inet_pton(AF_INET, text, address) == 1 &&
+           inet_ntop(AF_INET, address, canonical, sizeof(canonical)) &&
+           strcmp(text, canonical) == 0;
+}
+
+static bool parse_deny(struct ArxEgress *policy, char *text)
+{
+    struct in_addr address;
+    uint64_t bits;
+    uint32_t host;
+    uint32_t mask;
+    char *slash = strchr(text, '/');
+
+    if (!slash || policy->deny->len == ARX_MAX_DENY) {
+        return false;
+    }
+    *slash = '\0';
+    if (!parse_ipv4(text, &address) || !parse_decimal(slash + 1, 32, &bits)) {
+        return false;
+    }
+    host = ntohl(address.s_addr);
+    mask = UINT32_MAX << (32 - bits);
+    if ((host & mask) != host) {
+        return false;
+    }
+    for (guint i = 0; i < policy->deny->len; i++) {
+        struct ArxPrefix existing = g_array_index(policy->deny, struct ArxPrefix, i);
+        if (existing.network == host && existing.mask == mask) {
+            return false;
+        }
+    }
+    add_prefix(policy, host, bits);
+    return true;
+}
+
+static bool parse_policy(struct ArxEgress *policy, char *bytes, DWORD count)
+{
+    static const char fingerprint_key[] = "fingerprint=";
+    size_t footer_size = sizeof(fingerprint_key) - 1 + 64 + 1;
+    char *footer;
+    char *digest;
+    gchar **lines;
+    uint64_t index;
+    uint64_t luid;
+    bool ok;
+
+    if (count <= footer_size || memchr(bytes, '\0', count)) {
+        return false;
+    }
+    footer = bytes + count - footer_size;
+    if (footer[-1] != '\n' || bytes[count - 1] != '\n' ||
+        memcmp(footer, fingerprint_key, sizeof(fingerprint_key) - 1) != 0) {
+        return false;
+    }
+    digest = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+                                         (const guchar *)bytes, footer - bytes);
+    ok = memcmp(footer + sizeof(fingerprint_key) - 1, digest, 64) == 0;
+    g_free(digest);
+    if (!ok) {
+        return false;
+    }
+    footer[-1] = '\0';
+    lines = g_strsplit(bytes, "\n", -1);
+    ok = g_strv_length(lines) >= 5 &&
+         strcmp(lines[0], "version=1") == 0 &&
+         g_str_has_prefix(lines[1], "interface_index=") &&
+         parse_decimal(lines[1] + strlen("interface_index="), UINT32_MAX, &index) &&
+         g_str_has_prefix(lines[2], "interface_luid=") &&
+         parse_decimal(lines[2] + strlen("interface_luid="), UINT64_MAX, &luid) &&
+         g_str_has_prefix(lines[3], "source=") &&
+         parse_ipv4(lines[3] + strlen("source="), &policy->source) &&
+         g_str_has_prefix(lines[4], "gateway=") &&
+         parse_ipv4(lines[4] + strlen("gateway="), &policy->gateway) &&
+         policy->source.s_addr && policy->gateway.s_addr &&
+         policy->source.s_addr != policy->gateway.s_addr;
+    if (ok) {
+        policy->index = (uint32_t)index;
+        policy->luid.Value = luid;
+    }
+    for (guint i = 5; ok && lines[i]; i++) {
+        ok = g_str_has_prefix(lines[i], "deny=") &&
+             parse_deny(policy, lines[i] + strlen("deny="));
+    }
+    g_strfreev(lines);
+    return ok;
+}
+
+static bool load_policy(struct ArxEgress *policy, const char *path)
+{
+    BY_HANDLE_FILE_INFORMATION info;
+    WCHAR *wide;
+    char *bytes;
+    DWORD count;
+    bool ok;
+
+    /* The broker owns the parent path and authentication. Pin the plain
+     * file leaf open for the life of the backend, sharing only reads. */
+    if (strlen(path) < 4 || !g_ascii_isalpha(path[0]) || path[1] != ':' ||
+        (path[2] != '\\' && path[2] != '/') || strchr(path + 2, ':')) {
+        return false;
+    }
+    wide = g_utf8_to_utf16(path, -1, NULL, NULL, NULL);
+    if (!wide) {
+        return false;
+    }
+    policy->file = CreateFileW(wide, GENERIC_READ, FILE_SHARE_READ, NULL,
+                               OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, NULL);
+    g_free(wide);
+    if (policy->file == INVALID_HANDLE_VALUE ||
+        GetFileType(policy->file) != FILE_TYPE_DISK ||
+        !GetFileInformationByHandle(policy->file, &info) ||
+        (info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY |
+                                  FILE_ATTRIBUTE_REPARSE_POINT)) ||
+        info.nFileSizeHigh || !info.nFileSizeLow ||
+        info.nFileSizeLow > ARX_MAX_POLICY) {
+        return false;
+    }
+    bytes = g_malloc(info.nFileSizeLow);
+    ok = ReadFile(policy->file, bytes, info.nFileSizeLow, &count, NULL) &&
+         count == info.nFileSizeLow && parse_policy(policy, bytes, count);
+    g_free(bytes);
+    return ok;
+}
+
+static bool route_matches(struct ArxEgress *policy, uint32_t destination)
+{
+    MIB_IPFORWARDROW route;
+    NET_LUID luid;
+
+    return GetBestRoute(destination, policy->source.s_addr, &route) == NO_ERROR &&
+           route.dwForwardDest == 0 && route.dwForwardMask == 0 &&
+           route.dwForwardNextHop == policy->gateway.s_addr &&
+           route.dwForwardIfIndex == policy->index &&
+           ConvertInterfaceIndexToLuid(policy->index, &luid) == NO_ERROR &&
+           luid.Value == policy->luid.Value;
+}
+
+static bool enroll_addresses(struct ArxEgress *policy)
+{
+    PMIB_UNICASTIPADDRESS_TABLE table;
+    bool source_found = false;
+
+    if (GetUnicastIpAddressTable(AF_INET, &table) != NO_ERROR) {
+        return false;
+    }
+    if (table->NumEntries > ARX_MAX_ADDRESSES) {
+        FreeMibTable(table);
+        return false;
+    }
+    for (ULONG i = 0; i < table->NumEntries; i++) {
+        const MIB_UNICASTIPADDRESS_ROW *row = &table->Table[i];
+        uint32_t addr = ntohl(row->Address.Ipv4.sin_addr.s_addr);
+
+        if (row->Address.si_family != AF_INET || row->OnLinkPrefixLength > 32) {
+            FreeMibTable(table);
+            return false;
+        }
+        add_prefix(policy, addr, 32);
+        if (row->OnLinkPrefixLength) {
+            add_prefix(policy, addr, row->OnLinkPrefixLength);
+        }
+        if (row->InterfaceLuid.Value == policy->luid.Value &&
+            row->Address.Ipv4.sin_addr.s_addr == policy->source.s_addr &&
+            row->DadState == IpDadStatePreferred && !row->SkipAsSource) {
+            source_found = true;
+        }
+    }
+    FreeMibTable(table);
+    return source_found;
+}
+
+static VOID CALLBACK route_changed(PVOID context, PMIB_IPFORWARD_ROW2 row,
+                                   MIB_NOTIFICATION_TYPE type)
+{
+    struct ArxEgress *policy = context;
+    g_atomic_int_set(&policy->faulted, true);
+}
+
+static VOID CALLBACK address_changed(PVOID context, PMIB_UNICASTIPADDRESS_ROW row,
+                                     MIB_NOTIFICATION_TYPE type)
+{
+    struct ArxEgress *policy = context;
+    g_atomic_int_set(&policy->faulted, true);
+}
+
+static VOID CALLBACK interface_changed(PVOID context, PMIB_IPINTERFACE_ROW row,
+                                       MIB_NOTIFICATION_TYPE type)
+{
+    struct ArxEgress *policy = context;
+    g_atomic_int_set(&policy->faulted, true);
+}
+
+static bool arm_monitors(struct ArxEgress *policy)
+{
+    return NotifyRouteChange2(AF_INET, route_changed, policy, FALSE,
+                              &policy->route_notify) == NO_ERROR &&
+           NotifyUnicastIpAddressChange(AF_INET, address_changed, policy, FALSE,
+                                        &policy->address_notify) == NO_ERROR &&
+           NotifyIpInterfaceChange(AF_INET, interface_changed, policy, FALSE,
+                                   &policy->interface_notify) == NO_ERROR;
+}
+
+static bool uplink_present(struct ArxEgress *policy)
+{
+    MIB_IF_ROW2 iface = { 0 };
+    MIB_UNICASTIPADDRESS_ROW addr;
+
+    iface.InterfaceLuid = policy->luid;
+    InitializeUnicastIpAddressEntry(&addr);
+    addr.InterfaceLuid = policy->luid;
+    addr.Address.Ipv4.sin_family = AF_INET;
+    addr.Address.Ipv4.sin_addr = policy->source;
+    return GetIfEntry2(&iface) == NO_ERROR &&
+           iface.OperStatus == IfOperStatusUp &&
+           GetUnicastIpAddressEntry(&addr) == NO_ERROR &&
+           addr.DadState == IpDadStatePreferred && !addr.SkipAsSource &&
+           route_matches(policy, 0);
+}
+
+bool slirp_arx_enable(Slirp *slirp, const char *path, void (*fault)(void))
+{
+    struct ArxEgress *policy;
+
+    if (slirp->arx || !fault || !slirp->in_enabled || slirp->in6_enabled ||
+        slirp->vnetwork_addr.s_addr != htonl(0x0a000200u) ||
+        slirp->vnetwork_mask.s_addr != htonl(0xffffff00u) ||
+        slirp->vhost_addr.s_addr != htonl(0x0a000202u) ||
+        slirp->vnameserver_addr.s_addr != htonl(0x0a000203u) ||
+        slirp->vdhcp_startaddr.s_addr != htonl(0x0a00020fu)) {
+        return false;
+    }
+
+    policy = g_new0(struct ArxEgress, 1);
+    policy->file = INVALID_HANDLE_VALUE;
+    policy->deny = g_array_new(FALSE, FALSE, sizeof(struct ArxPrefix));
+    policy->fault = fault;
+    slirp->arx = policy;
+
+    if (!load_policy(policy, path) ||
+        !arm_monitors(policy) ||
+        !enroll_addresses(policy) ||
+        !uplink_present(policy) || g_atomic_int_get(&policy->faulted)) {
+        arx_cleanup(slirp);
+        return false;
+    }
+    add_prefix(policy, ntohl(policy->gateway.s_addr), 32);
+    slirp->disable_dns = true;
+    slirp->disable_host_loopback = true;
+    slirp->disable_dhcp = true;
+    slirp->enable_emu = false;
+    return true;
+}
+
+bool arx_allows(Slirp *slirp, struct in_addr address)
+{
+    struct ArxEgress *policy = slirp->arx;
+    uint32_t host = ntohl(address.s_addr);
+
+    return !g_atomic_int_get(&policy->faulted) &&
+           (address.s_addr & slirp->vnetwork_mask.s_addr) !=
+               slirp->vnetwork_addr.s_addr &&
+           !prefix_matches(arx_special, G_N_ELEMENTS(arx_special), host) &&
+           !prefix_matches((const struct ArxPrefix *)policy->deny->data,
+                           policy->deny->len, host);
+}
+
+bool arx_check_peer(struct socket *so, const struct sockaddr_storage *peer)
+{
+    const struct sockaddr_in *dst = (const struct sockaddr_in *)peer;
+    struct ArxEgress *policy = so->slirp->arx;
+
+    if (peer->ss_family == AF_INET && dst->sin_port &&
+        arx_allows(so->slirp, dst->sin_addr)) {
+        if (!route_matches(policy, dst->sin_addr.s_addr)) {
+            g_atomic_int_set(&policy->faulted, true);
+        }
+        if (!g_atomic_int_get(&policy->faulted)) {
+            return true;
+        }
+    }
+    errno = EPERM;
+    return false;
+}
+
+int arx_bind(struct socket *so, unsigned short family)
+{
+    struct ArxEgress *policy = so->slirp->arx;
+    struct sockaddr_in source = { .sin_family = AF_INET, .sin_addr = policy->source };
+    DWORD index = htonl(policy->index);
+
+    if (family != AF_INET || g_atomic_int_get(&policy->faulted)) {
+        errno = EPERM;
+        return -1;
+    }
+    if (setsockopt(so->s, IPPROTO_IP, IP_UNICAST_IF, &index, sizeof(index)) < 0 ||
+        bind(so->s, (struct sockaddr *)&source, sizeof(source)) < 0) {
+        g_atomic_int_set(&policy->faulted, true);
+        return -1;
+    }
+    return 0;
+}
+
+int arx_exclusive_listener(slirp_os_socket sock)
+{
+    int exclusive = 1;
+    return setsockopt(sock, SOL_SOCKET, SO_EXCLUSIVEADDRUSE,
+                      &exclusive, sizeof(exclusive));
+}
+
+bool arx_hostfwd(Slirp *slirp, const struct sockaddr *host, socklen_t host_len,
+                 const struct sockaddr *guest, socklen_t guest_len, int flags)
+{
+    const struct sockaddr_in *h = (const struct sockaddr_in *)host;
+    const struct sockaddr_in *g = (const struct sockaddr_in *)guest;
+    const struct socket *head = &slirp->tcb;
+
+    if (flags || host_len != sizeof(*h) || guest_len != sizeof(*g) ||
+        h->sin_family != AF_INET || g->sin_family != AF_INET ||
+        h->sin_addr.s_addr != htonl(INADDR_LOOPBACK) ||
+        ntohs(h->sin_port) < 49152 || ntohs(h->sin_port) > 49215 ||
+        g->sin_addr.s_addr != slirp->vdhcp_startaddr.s_addr ||
+        g->sin_port != htons(443) || g_atomic_int_get(&slirp->arx->faulted)) {
+        return false;
+    }
+    for (const struct socket *so = head->so_next; so != head; so = so->so_next) {
+        if (so->so_state & SS_HOSTFWD) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void arx_poll(Slirp *slirp, int poll_error)
+{
+    struct ArxEgress *policy = slirp->arx;
+    struct socket *so, *next;
+    gint64 now = g_get_monotonic_time();
+
+    if (policy->quiesced) {
+        return;
+    }
+    if (poll_error ||
+        (now >= policy->next_health_check && !uplink_present(policy))) {
+        g_atomic_int_set(&policy->faulted, true);
+    }
+    if (now >= policy->next_health_check) {
+        policy->next_health_check = now + G_USEC_PER_SEC;
+    }
+    if (!g_atomic_int_get(&policy->faulted)) {
+        return;
+    }
+    policy->quiesced = true;
+    for (so = slirp->tcb.so_next; so != &slirp->tcb; so = next) {
+        struct linger abort_pending = { 1, 0 };
+        next = so->so_next;
+        if (!(so->so_state & (SS_HOSTFWD | SS_INCOMING))) {
+            if (have_valid_socket(so->s)) {
+                setsockopt(so->s, SOL_SOCKET, SO_LINGER,
+                           &abort_pending, sizeof(abort_pending));
+            }
+            tcp_close(sototcpcb(so));
+        }
+    }
+    for (so = slirp->udb.so_next; so != &slirp->udb; so = next) {
+        next = so->so_next;
+        udp_detach(so);
+    }
+    policy->fault();
+}
+
+void arx_cleanup(Slirp *slirp)
+{
+    struct ArxEgress *policy = slirp->arx;
+
+    if (!policy) {
+        return;
+    }
+    /* Cancellation drains callbacks. If Windows cannot cancel one, retain
+     * its context until process exit so a late callback cannot use freed memory. */
+    bool drained = true;
+    HANDLE notifications[] = {
+        policy->route_notify, policy->address_notify, policy->interface_notify,
+    };
+    for (size_t i = 0; i < G_N_ELEMENTS(notifications); i++) {
+        if (notifications[i] && CancelMibChangeNotify2(notifications[i]) != NO_ERROR) {
+            drained = false;
+        }
+    }
+    if (policy->file != INVALID_HANDLE_VALUE) {
+        CloseHandle(policy->file);
+    }
+    g_array_free(policy->deny, TRUE);
+    if (drained) {
+        g_free(policy);
+    }
+    slirp->arx = NULL;
+}
+
+#else
+
+/* The option fails closed on hosts without the Windows uplink implementation. */
+bool slirp_arx_enable(Slirp *slirp, const char *path, void (*fault)(void))
+{
+    return false;
+}
+
+bool arx_allows(Slirp *slirp, struct in_addr address) { return false; }
+bool arx_check_peer(struct socket *so, const struct sockaddr_storage *peer) { return false; }
+int arx_bind(struct socket *so, unsigned short family) { return -1; }
+int arx_exclusive_listener(slirp_os_socket sock) { return -1; }
+void arx_poll(Slirp *slirp, int poll_error) {}
+void arx_cleanup(Slirp *slirp) {}
+bool arx_hostfwd(Slirp *slirp, const struct sockaddr *host, socklen_t host_len,
+                 const struct sockaddr *guest, socklen_t guest_len, int flags)
+{
+    return false;
+}
+
+#endif
