@@ -0,0 +1,398 @@
+/*
+ * Arxcovo qualification consumer-open witness, protocol v1.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qemu/units.h"
+#include "qemu/arx-witness.h"
+
+enum {
+    FRAME_BYTES = 48,
+    NONCE_BYTES = 16,
+    MAX_SEQUENCE = 64,
+    MAX_ROM_BYTES = 16 * MiB,
+};
+
+enum {
+    INIT = 1,
+    REQUEST = 2,
+    GRANT = 3,
+    ADOPT = 4,
+    ACK = 5,
+    STARTUP = 6,
+    TERMINAL = 7,
+};
+
+enum {
+    PAUSED = 1,
+    INFO = 2,
+    CREATE = 3,
+};
+
+enum {
+    BIOS = 1,
+    VAPIC = 2,
+    IMAGE = 3,
+    GOLDEN = 4,
+    OUTPUT = 5,
+};
+
+static HANDLE rx, tx;
+static uint8_t nonce[NONCE_BYTES];
+static unsigned stage, sequence;
+static SRWLOCK wire_lock = SRWLOCK_INIT;
+static const char *bios, *image, *golden;
+static char *vapic;
+static bool output_taken, startup;
+
+static G_NORETURN void refuse(void)
+{
+    /* No path, peer text, nonce or handle is part of an error report. */
+    ExitProcess(125);
+}
+
+static void transfer(HANDLE pipe, uint8_t *p, DWORD size, bool write)
+{
+    while (size) {
+        DWORD count = 0;
+        BOOL ok = write ? WriteFile(pipe, p, size, &count, NULL)
+                        : ReadFile(pipe, p, size, &count, NULL);
+        if (!ok || !count || count > size) {
+            refuse();
+        }
+        size -= count;
+        p += count;
+    }
+}
+
+static void frame(uint8_t *p, unsigned kind, unsigned role, unsigned site,
+                  bool write, uint64_t handle)
+{
+    memset(p, 0, FRAME_BYTES);
+    memcpy(p, "ARXW", 4);
+    p[4] = 1; /* wire version */
+    p[5] = 1; /* open-table version */
+    p[6] = kind;
+    p[7] = stage;
+    memcpy(p + 8, nonce, NONCE_BYTES);
+    stl_le_p(p + 24, sequence);
+    p[28] = role;
+    p[29] = site;
+    p[30] = write;
+    stq_le_p(p + 32, handle);
+}
+
+static void send_frame(unsigned kind, unsigned role, unsigned site, bool write,
+                       uint64_t handle)
+{
+    uint8_t p[FRAME_BYTES];
+
+    frame(p, kind, role, site, write, handle);
+    transfer(tx, p, sizeof(p), true);
+}
+
+static uint64_t recv_frame(unsigned kind, unsigned role, unsigned site,
+                           bool write)
+{
+    uint8_t p[FRAME_BYTES], expected[FRAME_BYTES];
+    uint64_t handle;
+
+    transfer(rx, p, sizeof(p), false);
+    handle = ldq_le_p(p + 32);
+    if ((kind == GRANT) != (handle != 0)) {
+        refuse();
+    }
+    frame(expected, kind, role, site, write, handle);
+    if (memcmp(p, expected, sizeof(p))) {
+        refuse();
+    }
+    return handle;
+}
+
+static HANDLE endpoint(const wchar_t *name)
+{
+    wchar_t text[17];
+    DWORD count = GetEnvironmentVariableW(name, text, ARRAY_SIZE(text));
+    uintptr_t value = 0;
+    DWORD i;
+    HANDLE handle;
+
+    if (!count || count >= ARRAY_SIZE(text) || text[0] == L'0') {
+        refuse();
+    }
+    for (i = 0; i < count; i++) {
+        unsigned digit;
+        if (text[i] >= L'0' && text[i] <= L'9') {
+            digit = text[i] - L'0';
+        } else if (text[i] >= L'a' && text[i] <= L'f') {
+            digit = text[i] - L'a' + 10;
+        } else {
+            refuse();
+        }
+        value = (value << 4) | digit;
+    }
+    handle = (HANDLE)value;
+    if (handle == INVALID_HANDLE_VALUE || GetFileType(handle) != FILE_TYPE_PIPE
+        || handle == GetStdHandle(STD_INPUT_HANDLE)
+        || handle == GetStdHandle(STD_OUTPUT_HANDLE)
+        || handle == GetStdHandle(STD_ERROR_HANDLE)
+        || !SetHandleInformation(handle, HANDLE_FLAG_INHERIT, 0)
+        || !SetEnvironmentVariableW(name, NULL)) {
+        refuse();
+    }
+    return handle;
+}
+
+static void constrain_loader(void)
+{
+    /* The launcher separately constrains and witnesses initial imports. */
+    if (!SetDefaultDllDirectories(LOAD_LIBRARY_SEARCH_SYSTEM32)) {
+        refuse();
+    }
+}
+
+static void init(unsigned expected_stage)
+{
+    uint8_t p[FRAME_BYTES], expected[FRAME_BYTES];
+    const uint8_t zero_nonce[NONCE_BYTES] = {0};
+
+    stage = expected_stage;
+    rx = endpoint(L"ARX_WITNESS_RX");
+    tx = endpoint(L"ARX_WITNESS_TX");
+    if (rx == tx) {
+        refuse();
+    }
+    transfer(rx, p, sizeof(p), false);
+    memcpy(nonce, p + 8, sizeof(nonce));
+    frame(expected, INIT, 0, 0, false, 0);
+    if (!memcmp(nonce, zero_nonce, sizeof(nonce))
+        || memcmp(p, expected, sizeof(p))) {
+        refuse();
+    }
+}
+
+static bool exact(const char *a, const char *b)
+{
+    return a && b && !strcmp(a, b);
+}
+
+/* Paths are selectors from the sealed argv. The grant has no pathname. */
+static bool drive_path(const char *s)
+{
+    return strlen(s) >= 4 && strlen(s) < MAX_PATH &&
+        g_ascii_isalpha(s[0]) && s[1] == ':' &&
+        (s[2] == '/' || s[2] == '\\') &&
+        !strpbrk(s + 2, ":*?<>|\"\r\n");
+}
+
+void arx_witness_system(int argc, char **argv)
+{
+    static const char *fixed[] = {
+        "-no-user-config", "-nodefaults", "-display", "none",
+        "-serial", "none", "-monitor", "none", "-nic", "none",
+        "-accel", "whpx", "-machine", "pc-q35-11.1", "-smp", "1",
+        "-m", "256M", "-L", NULL, "-bios", NULL, "-S",
+        "-chardev", "stdio,id=arxqmp,signal=off",
+        "-mon", "chardev=arxqmp,mode=control",
+    };
+    size_t i;
+
+    constrain_loader();
+    if (argc != (int)ARRAY_SIZE(fixed) + 1) {
+        refuse();
+    }
+    for (i = 0; i < ARRAY_SIZE(fixed); i++) {
+        if (fixed[i] ? !exact(argv[i + 1], fixed[i])
+                     : !drive_path(argv[i + 1])) {
+            refuse();
+        }
+    }
+    bios = argv[22];
+    if (!g_str_has_suffix(bios, "/bios-256k.bin") &&
+        !g_str_has_suffix(bios, "\\bios-256k.bin")) {
+        refuse();
+    }
+    vapic = g_strdup_printf("%s/kvmvapic.bin", argv[20]);
+    init(PAUSED);
+}
+
+void arx_witness_img(int argc, char **argv)
+{
+    const char *size;
+
+    constrain_loader();
+    if (argc == 6 && exact(argv[1], "info") &&
+        exact(argv[2], "--output=json") && exact(argv[3], "-f") &&
+        exact(argv[4], "qcow2") && drive_path(argv[5])) {
+        image = argv[5];
+        init(INFO);
+        return;
+    }
+    if ((argc != 8 && argc != 12) || !exact(argv[1], "create") ||
+        !exact(argv[2], "-f") || !exact(argv[3], "qcow2") ||
+        !exact(argv[4], "-o") ||
+        !exact(argv[5], "compat=1.1,cluster_size=65536,lazy_refcounts=off") ||
+        !drive_path(argv[argc - 2])) {
+        refuse();
+    }
+    image = argv[argc - 2];
+    size = argv[argc - 1];
+    if (!*size || *size == '0' || strlen(size) > 19 ||
+        strspn(size, "0123456789") != strlen(size)) {
+        refuse();
+    }
+    if (argc == 12) {
+        if (!exact(argv[6], "-F") || !exact(argv[7], "qcow2") ||
+            !exact(argv[8], "-b") || !drive_path(argv[9]) ||
+            !g_ascii_strcasecmp(image, argv[9])) {
+            refuse();
+        }
+        golden = argv[9];
+    }
+    init(CREATE);
+}
+
+static void next_sequence(void)
+{
+    if (++sequence > MAX_SEQUENCE) {
+        refuse();
+    }
+}
+
+static HANDLE adopt(unsigned role, unsigned site, bool write)
+{
+    HANDLE file;
+    DWORD flags;
+    uint64_t value;
+
+    AcquireSRWLockExclusive(&wire_lock);
+    if (!role || (role == OUTPUT && output_taken)) {
+        refuse();
+    }
+    next_sequence();
+    send_frame(REQUEST, role, site, write, 0);
+    value = recv_frame(GRANT, role, site, write);
+    file = (HANDLE)(uintptr_t)value;
+    if (file == INVALID_HANDLE_VALUE || GetFileType(file) != FILE_TYPE_DISK ||
+        !GetHandleInformation(file, &flags) || (flags & HANDLE_FLAG_INHERIT)) {
+        refuse();
+    }
+    send_frame(ADOPT, role, site, write, value);
+    recv_frame(ACK, role, site, write);
+    if (role == OUTPUT) {
+        output_taken = true;
+    }
+    ReleaseSRWLockExclusive(&wire_lock);
+    return file;
+}
+
+char *arx_witness_find_rom(const char *name)
+{
+    if (stage == PAUSED && exact(name, bios)) {
+        return g_strdup(bios);
+    }
+    if (stage == PAUSED && exact(name, "kvmvapic.bin")) {
+        return g_strdup(vapic);
+    }
+    refuse();
+}
+
+int arx_witness_rom_fd(const char *name, unsigned site)
+{
+    unsigned role = 0;
+    HANDLE file;
+    int fd;
+
+    if (stage == PAUSED && exact(name, bios)) {
+        role = BIOS;
+    } else if (stage == PAUSED && site == ARX_ROM_READ && exact(name, vapic)) {
+        role = VAPIC;
+    }
+    file = adopt(role, site, false);
+    fd = _open_osfhandle((intptr_t)file, O_RDONLY | O_BINARY);
+    if (fd < 0) {
+        CloseHandle(file);
+        refuse();
+    }
+    return fd;
+}
+
+bool arx_witness_rom_read(const char *name, uint8_t **data, gsize *size)
+{
+    int fd = arx_witness_rom_fd(name, ARX_ROM_READ);
+    int64_t length = lseek(fd, 0, SEEK_END);
+    g_autofree uint8_t *buffer = NULL;
+    size_t offset = 0;
+
+    if (length <= 0 || length > MAX_ROM_BYTES || lseek(fd, 0, SEEK_SET) != 0) {
+        close(fd);
+        return false;
+    }
+    buffer = g_malloc(length);
+    while (offset < length) {
+        int n = read(fd, buffer + offset, length - offset);
+        if (n <= 0) {
+            close(fd);
+            return false;
+        }
+        offset += n;
+    }
+    if (close(fd) != 0) {
+        return false;
+    }
+    *data = g_steal_pointer(&buffer);
+    *size = length;
+    return true;
+}
+
+bool arx_witness_output(const char *name)
+{
+    return stage == CREATE && exact(name, image);
+}
+
+HANDLE arx_witness_block(const char *name, bool write)
+{
+    unsigned role = 0;
+
+    if (write && arx_witness_output(name)) {
+        role = OUTPUT;
+    } else if (!write && stage == INFO && exact(name, image)) {
+        role = IMAGE;
+    } else if (!write && stage == CREATE && exact(name, golden)) {
+        role = GOLDEN;
+    }
+    return adopt(role, ARX_BLOCK_OPEN, write);
+}
+
+bool arx_witness_qmp(const char *command)
+{
+    return exact(command, "qmp_capabilities") || exact(command, "query-status")
+        || exact(command, "quit") || (startup && exact(command, "cont"));
+}
+
+void arx_witness_startup(void)
+{
+    AcquireSRWLockExclusive(&wire_lock);
+    if (!startup) {
+        next_sequence();
+        send_frame(STARTUP, 0, 0, false, 0);
+        recv_frame(ACK, 0, 0, false);
+        startup = true;
+    }
+    ReleaseSRWLockExclusive(&wire_lock);
+}
+
+void arx_witness_finish(void)
+{
+    AcquireSRWLockExclusive(&wire_lock);
+    if ((stage == PAUSED && !startup) || (stage == CREATE && !output_taken)) {
+        refuse();
+    }
+    next_sequence();
+    send_frame(TERMINAL, 0, 0, false, 0);
+    recv_frame(ACK, 0, 0, false);
+    CloseHandle(tx);
+    CloseHandle(rx);
+    ReleaseSRWLockExclusive(&wire_lock);
+}
