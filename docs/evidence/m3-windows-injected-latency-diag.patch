+// [DIAG-INJ] temporary experiment: sleep the injected per-store delay for `op`.
+pub(super) fn inject(store: usize, op: Op) {
+    let Some(s) = lookup(store) else { return };
+    let d = match op {
+        Op::Vote => s.vote_delay_ms.load(Relaxed),
+        Op::Append => s.append_delay_ms.load(Relaxed),
+        _ => 0,
+    };
+    if d > 0 {
+        std::thread::sleep(Duration::from_millis(d as u64));
+    }
+}
+// [DIAG-INJ] temporary experiment: `ARX_DIAG_INJECT_MS=vote,append,apply`, each <= 1250, all nodes.
+fn inject_from_env(nodes: &[Arc<NodeStats>; 3]) {
+    let Ok(v) = std::env::var("ARX_DIAG_INJECT_MS") else { return };
+    let d: Vec<u32> = v.split(',').map(|x| x.trim().parse().unwrap()).collect();
+    assert!(d.len() == 3 && d.iter().all(|x| *x <= 1250), "[DIAG-INJ] bad {v}");
+    for n in nodes {
+        n.vote_delay_ms.store(d[0], Relaxed);
+        n.append_delay_ms.store(d[1], Relaxed);
+        n.apply_delay_ms.store(d[2], Relaxed);
+    }
+    eprintln!("[DIAG-INJ] vote={} append={} apply={} nodes=3", d[0], d[1], d[2]);
+}
